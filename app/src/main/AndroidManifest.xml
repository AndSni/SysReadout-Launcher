<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Swipe down opens the notification shade. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- "Uninstall" from an app's long-press menu. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Tapping the clock opens the alarms screen. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Log rows: connection type, IP, Wi-Fi signal. Install-time, no prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Real app names for system packages in the monitor (processes, connections, traffic). -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Only the optional DNS monitor uses the network: it relays apps' own lookups
         to the real DNS server. Nothing else in SysReadout connects anywhere. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Optional lock-screen wallpaper (your image or a snapshot of the log). -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- "radio" row: is Bluetooth on (Android 11 and older need this to ask). -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <!-- Optional log rows; each is asked for only when the user switches that row on:
         GPS fix, satellites, Wi-Fi name, nearby networks, serving cell, sunrise (location);
         5G/LTE link details (phone); connected Bluetooth devices; steps. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- None of that hardware is required to install. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <!-- System monitor: app switches, screen time, traffic. Granted by the user in
         Settings > Usage access; nothing happens without it. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Launchable apps only: no QUERY_ALL_PACKAGES needed. -->
    <queries>
        <!-- Shizuku, for the optional system monitor. -->
        <package android:name="moe.shizuku.privileged.api" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SysReadout">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receives the Shizuku binder when the user has Shizuku running. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Optional DNS monitor; routes only DNS, see DnsVpnService. -->
        <service
            android:name=".monitor.DnsVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Optional notification log: who notified when; see NotifListener. -->
        <service
            android:name=".monitor.NotifListener"
            android:exported="false"
            android:label="@string/notif_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Only used for double-tap-to-lock; reads no window content. -->
        <service
            android:name=".system.LockService"
            android:exported="false"
            android:label="@string/lock_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lock_service" />
        </service>
    </application>
</manifest>
